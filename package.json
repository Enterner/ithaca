{
  "name": "ithaca",
  "private": true,
  "version": "0.1.0",
  "description": "Ithaca —— 跑在 Nostos 内核之上的可逆编程代理。本文件是开发任务入口（构建/测试/回归/e2e/打包/启动），脚本零依赖，只用 Node 内置模块。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --preset release",
    "test": "node scripts/build.mjs --test-only",
    "selftest": "node scripts/selftest.mjs",
    "regress": "node scripts/regress.mjs",
    "e2e:session": "playwright test --project=api",
    "e2e:ui": "playwright test --project=ui",
    "e2e:all": "playwright test",
    "eval": "node scripts/eval.mjs",
    "check": "npm run build && npm run regress && npm run e2e:all",
    "dev": "node scripts/dev.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:zip": "node scripts/pack.mjs --no-installer",
    "pack:redist": "node scripts/pack.mjs --with-redist"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
